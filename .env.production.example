# ==============================================================================
# PricePulse - Production Environment Configuration
# ==============================================================================

# 1. Frontend Environment Variables
NEXT_PUBLIC_API_URL=https://your-api-domain.com/api
NEXT_PUBLIC_WS_URL=wss://your-api-domain.com/ws/market

# 2. Backend Environment Variables
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME=PricePulse
SECRET_KEY=generate_a_secure_64_character_hex_key_for_production_security_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 3. Production PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://market_user:strong_password_here@postgres:5432/stock_market_db

# 4. Redis Cache & WebSocket PubSub
REDIS_ENABLED=True
REDIS_URL=redis://redis:6379/0

# 5. Live Market Feed & Official NSE Holiday Calendar
MARKET_DATA_PROVIDER=live
TICK_INTERVAL_SECONDS=1.0
RESPECT_MARKET_HOURS=True
SIMULATE_WHEN_CLOSED=False

# 6. Production CORS Allowed Origins
BACKEND_CORS_ORIGINS=https://your-frontend-domain.com,https://pricepulse.yourdomain.com

# 7. Optional Alert Dispatch Channels (Telegram / Email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_or_smtp_password
EMAILS_FROM_EMAIL=alerts@yourdomain.com
