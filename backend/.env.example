# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./market_platform.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stock_market_db

# Security & JWT
SECRET_KEY=dev_secret_key_change_in_production_market_platform_9988
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis (Set to True if running redis server)
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# Market Data Provider
# Set to 'live' for real-time live Indian Market (NSE) quotes
# Set to 'mock' for simulated tick movement
MARKET_DATA_PROVIDER=mock
TICK_INTERVAL_SECONDS=1.0

# Trading Hours & Holiday Enforcement
# RESPECT_MARKET_HOURS: If True, only streams price movements during 09:15-15:30 IST Mon-Fri (excluding NSE Holidays)
RESPECT_MARKET_HOURS=True
# SIMULATE_WHEN_CLOSED: If False, freezes prices when market is closed or on holidays
SIMULATE_WHEN_CLOSED=False

# Optional Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
